---
import { Image } from 'astro:assets';
import type { HighlightKind } from '@/data/highlights';

/**
 * Covers of the highlight cards, drawn in HTML/CSS like the project covers but in the
 * page tokens, so they follow the theme: a plate for an achievement, a framed sheet for
 * a certificate and an event pass for community work, each carrying the item's initials.
 * A card with a real image shows it instead: a certificate's official image on the same
 * grey grid (a badge stands centred, a certificate lies as a sheet), or an event photo
 * filling the cover. It is grey like the site's photos and takes its colours when the
 * card is pointed at or focused. Decorative (aria-hidden): the card text says what it is.
 * Every size is in container units, so the drawing scales with the card, down to the
 * square thumbnail of narrow screens.
 */
interface Props {
  kind: HighlightKind;
  mark: string;
  image?: ImageMetadata | undefined;
}

const { kind, mark, image } = Astro.props;
// An event photo fills the cover; a transparent PNG is a badge; a JPG is the certificate itself.
const layout = kind === 'community' ? 'photo' : image?.format === 'png' ? 'badge' : 'sheet';
const sizes = {
  photo: { widths: [176, 360, 560, 800], sizes: '(max-width: 600px) 88px, (max-width: 960px) 46vw, 280px' },
  badge: { widths: [160, 320, 480], sizes: '(max-width: 600px) 72px, (max-width: 960px) 29vw, 170px' },
  sheet: { widths: [160, 320, 480, 720], sizes: '(max-width: 600px) 80px, (max-width: 960px) 37vw, 220px' },
}[layout];
---

<div class:list={['hcover', image ? ['hcover--image', `hcover--${layout}`] : `hcover--${kind}`]} aria-hidden="true">
  {
    image && (
      <div class="art">
        <Image src={image} alt="" widths={sizes.widths} sizes={sizes.sizes} loading="lazy" class="shot" />
      </div>
    )
  }

  {
    !image && kind === 'achievement' && (
      <div class="art">
        <span class="plate plate--back" />
        <span class="plate">
          <b class="mark">{mark}</b>
        </span>
        <i class="bit bit-a" />
        <i class="bit bit-b" />
        <i class="bit bit-c" />
      </div>
    )
  }

  {
    !image && kind === 'certification' && (
      <div class="art sheet">
        <b class="mark">{mark}</b>
        <span class="line w60" />
        <span class="line w40" />
        <span class="stamp" />
      </div>
    )
  }

  {
    !image && kind === 'community' && (
      <div class="art pass">
        <span class="strap" />
        <span class="slot" />
        <b class="mark">{mark}</b>
        <span class="line w60" />
        <span class="band" />
      </div>
    )
  }
</div>

<style>
  /* content-visibility: off-screen covers skip layout; aspect-ratio fixes their size. */
  .hcover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    content-visibility: auto;
    overflow: hidden;
    isolation: isolate;
    font-family: var(--font-sans);
    user-select: none;
  }

  /* Square grid behind the drawing. */
  .hcover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-position: center;
    background-size: 12.5cqi 12.5cqi;
  }

  .art {
    position: relative;
  }

  .mark {
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .line {
    display: block;
    height: max(2px, 1cqi);
    background: currentColor;
    opacity: 0.18;
  }

  .w40 {
    width: 40%;
  }

  .w60 {
    width: 60%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .art {
      transition: scale 0.6s var(--ease);
    }
  }

  /* 1 · Achievement: a solid plate on an ink tile, with a frame and a few square bits. */
  .hcover--achievement {
    --grid: color-mix(in srgb, var(--on-ink) 9%, transparent);
    background: var(--ink);
  }

  .hcover--achievement .art {
    width: 38cqi;
    aspect-ratio: 1;
    rotate: -6deg;
  }

  .plate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--on-ink);
    color: var(--ink);
    box-shadow: 0 2cqi 5cqi -1cqi rgb(0 0 0 / 0.35);
  }

  .plate--back {
    translate: 5cqi 5cqi;
    border: max(1px, 0.5cqi) solid color-mix(in srgb, var(--on-ink) 40%, transparent);
    background: none;
    box-shadow: none;
  }

  .hcover--achievement .mark {
    font-size: 10cqi;
  }

  .bit {
    position: absolute;
    aspect-ratio: 1;
    background: var(--on-ink);
  }

  .bit-a {
    top: -12cqi;
    left: -14cqi;
    width: 3.5cqi;
  }

  .bit-b {
    top: 6cqi;
    right: -17cqi;
    width: 2.5cqi;
    opacity: 0.6;
  }

  .bit-c {
    bottom: -14cqi;
    left: 4cqi;
    width: 3cqi;
    border: max(1px, 0.5cqi) solid var(--on-ink);
    background: none;
  }

  /* 2 · Certification: a framed sheet with a square seal. */
  .hcover--certification {
    --grid: color-mix(in srgb, var(--ink) 6%, transparent);
    background: var(--backdrop);
  }

  .sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.6cqi;
    width: 60cqi;
    aspect-ratio: 4 / 3;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 4cqi 6cqi -2cqi rgb(0 0 0 / 0.3);
    rotate: -3deg;
  }

  /* Double frame inside the paper margin. */
  .sheet::before {
    content: '';
    position: absolute;
    inset: 3cqi;
    border: max(3px, 1.2cqi) double color-mix(in srgb, var(--ink) 70%, transparent);
  }

  .sheet .mark {
    margin-bottom: 1cqi;
    font-size: 8cqi;
  }

  .stamp {
    position: absolute;
    right: -5cqi;
    bottom: -5cqi;
    width: 11cqi;
    aspect-ratio: 1;
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1.4cqi var(--ink),
      inset 0 0 0 1.9cqi var(--on-ink);
    rotate: 12deg;
  }

  /* 3 · Community: an event pass hanging from its lanyard. */
  .hcover--community {
    --grid: color-mix(in srgb, var(--ink) 6%, transparent);
    background: var(--surface);
  }

  .pass {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.6cqi;
    width: 34cqi;
    aspect-ratio: 3 / 4;
    margin-top: 12cqi;
    padding-top: 10cqi;
    border: max(1px, 0.5cqi) solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 4cqi 6cqi -2cqi rgb(0 0 0 / 0.25);
    rotate: 4deg;
    transform-origin: 50% 0;
  }

  .strap {
    position: absolute;
    bottom: calc(100% + max(1px, 0.5cqi));
    left: 50%;
    width: 8cqi;
    height: 60cqi;
    translate: -50% 0;
    background: var(--ink);
  }

  .slot {
    position: absolute;
    top: 3cqi;
    left: 50%;
    width: 10cqi;
    height: 2.2cqi;
    translate: -50% 0;
    border: max(1px, 0.4cqi) solid var(--ink);
    background: var(--surface);
  }

  .pass .mark {
    font-size: 8cqi;
  }

  .band {
    width: 100%;
    height: 7cqi;
    margin-top: auto;
    background: var(--ink);
  }

  /* 4 · Official image: a badge standing on the grid, or the certificate lying as a sheet.
     Grey like the site's photos (and dimmed in dark mode); the card sets --shot-gray to 0
     under the pointer or focus (HighlightGrid.astro), and the colours fade in. */
  .hcover--image {
    --grid: color-mix(in srgb, var(--ink) 6%, transparent);
    background: var(--backdrop);
  }

  .hcover--image .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    filter: var(--photo-filter);
  }

  .hcover :global(.shot) {
    display: block;
    height: auto;
    filter: grayscale(var(--shot-gray, 1)) drop-shadow(0 2cqi 3cqi rgb(0 0 0 / 0.28));
    transition: filter 0.45s var(--ease);
  }

  /* The badge fits a box, whatever its shape (round, square or wide). */
  .hcover--badge :global(.shot) {
    width: 62cqi;
    height: 50cqi;
    object-fit: contain;
  }

  .hcover--sheet :global(.shot) {
    width: 80cqi;
  }

  /* An event photo fills the cover edge to edge, without the grid or a shadow. */
  .hcover--photo :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(var(--shot-gray, 1));
  }

  /* Square thumbnail (narrow screens): bigger drawing, fewer details. */
  @container (max-width: 160px) {
    .hcover--badge :global(.shot) {
      width: 82cqi;
      height: 72cqi;
    }

    .hcover--sheet :global(.shot) {
      width: 88cqi;
    }

    .hcover--achievement .art {
      width: 56cqi;
    }

    .hcover--achievement .mark {
      font-size: 15cqi;
    }

    .bit,
    .line {
      display: none;
    }

    .sheet {
      width: 74cqi;
    }

    .sheet .mark {
      margin-bottom: 0;
      font-size: 14cqi;
    }

    .sheet::before {
      inset: 5cqi;
    }

    .pass {
      width: 50cqi;
      margin-top: 14cqi;
      padding-top: 14cqi;
    }

    .pass .mark {
      font-size: 13cqi;
    }
  }
</style>
