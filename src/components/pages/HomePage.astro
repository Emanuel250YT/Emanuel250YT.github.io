---
import About from '@/components/sections/About.astro';
import Achievements from '@/components/sections/Achievements.astro';
import Contact from '@/components/sections/Contact.astro';
import Hero from '@/components/sections/Hero.astro';
import Process from '@/components/sections/Process.astro';
import Projects from '@/components/sections/Projects.astro';
import Services from '@/components/sections/Services.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';
import {
  graph,
  organizationNodes,
  pageNode,
  personNode,
  projectListNode,
  serviceCatalogNode,
  websiteNode,
} from '@/lib/schema';
import { portraitRef } from '@/lib/portrait';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const portrait = await portraitRef();

const jsonLd = graph([
  personNode(locale, portrait, { offers: true }),
  ...organizationNodes(locale),
  websiteNode(),
  ...pageNode({
    locale,
    path: '',
    title: t.meta.title,
    description: t.meta.description,
    type: 'ProfilePage',
    image: portrait,
  }),
  projectListNode(locale),
  serviceCatalogNode(locale),
]);
---

<BaseLayout locale={locale} path="" title={t.meta.title} description={t.meta.description} ogType="profile" jsonLd={jsonLd}>
  <!-- Section order: who → what → how → proof → contact. Numbers feed the "01 —" eyebrows. -->
  <Hero locale={locale} />
  <About locale={locale} index={1} />
  <Services locale={locale} index={2} />
  <Process locale={locale} index={3} />
  <Projects locale={locale} index={4} />
  <Achievements locale={locale} index={5} />
  <Contact locale={locale} index={6} />
</BaseLayout>
