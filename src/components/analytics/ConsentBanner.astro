---
import { site } from '@/config/site';
import { useTranslations } from '@/i18n';
import { localePath, type Locale } from '@/i18n/locales';

/**
 * Analytics consent banner (GDPR "basic" mode): neither Google Analytics nor
 * Google Tag Manager loads until the visitor accepts. Rendered only when a GA4
 * or GTM ID is configured.
 * Accept and decline have the same weight, as consent rules require.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const measurementId: string = site.googleAnalyticsId;
const containerId: string = site.googleTagManagerId;
---

{
  (measurementId || containerId) && (
    <div
      class="consent"
      role="region"
      aria-label={t.footer.cookies}
      data-consent
      data-ga-id={measurementId}
      data-gtm-id={containerId}
      hidden
    >
      <p class="consent-text">
        {t.consent.text} <a href={localePath(locale, 'privacy')}>{t.privacy.heading}</a>
      </p>
      <div class="consent-actions">
        <button type="button" class="btn btn--sm btn--light" data-consent-choice="denied">
          {t.consent.reject}
        </button>
        <button type="button" class="btn btn--sm btn--light" data-consent-choice="granted">
          {t.consent.accept}
        </button>
      </div>
    </div>
  )
}

<script>
  import { initAnalytics } from '@/scripts/analytics';

  initAnalytics();
</script>

<style>
  .consent {
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    gap: 14px;
    width: min(420px, calc(100vw - 32px));
    padding: 18px 18px 16px;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.5);
  }

  .consent[hidden] {
    display: none;
  }

  .consent:not([hidden]) {
    animation: consent-in 0.5s var(--ease) both;
  }

  .consent-text {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  .consent-text a {
    color: #fff;
  }

  .consent-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* Small phones: a compact full-width sheet, so less of the hero (and its CTA) hides behind it. */
  @media (max-width: 480px) {
    .consent {
      left: 0;
      bottom: 0;
      gap: 10px;
      width: 100%;
      padding: 12px max(16px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom))
        max(16px, env(safe-area-inset-left));
    }

    .consent-text {
      font-size: 0.8rem;
      line-height: 1.4;
    }

    .consent-actions .btn {
      --btn-h: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent:not([hidden]) {
      animation-name: consent-fade;
    }
  }

  @keyframes consent-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
