---
import type { RichText } from '@/i18n/types';

interface Props {
  as?: 'h1' | 'h2' | 'h3';
  parts: RichText;
  class?: string;
  id?: string;
  /** Extra wait before the heading types itself in (src/scripts/typing.ts), in ms. */
  typeDelay?: number;
}

const { as: Tag = 'h2', parts, class: className, id, typeDelay } = Astro.props;
---

<Tag class:list={['display', className]} id={id} data-type data-type-delay={typeDelay}>
  {
    parts.map((part) =>
      'br' in part ? (
        <Fragment>
          {part.space !== false && ' '}
          <br class="rich-br" />
        </Fragment>
      ) : part.muted ? (
        <span class="muted">{part.text}</span>
      ) : (
        <Fragment>{part.text}</Fragment>
      ),
    )
  }
</Tag>

<style>
  /* On narrow screens the text flows freely; the break is a desktop-only layout choice. */
  @media (max-width: 720px) {
    .rich-br {
      display: none;
    }
  }
</style>
