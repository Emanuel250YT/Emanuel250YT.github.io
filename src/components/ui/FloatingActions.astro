---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';
import { whatsappUrl } from '@/lib/whatsapp';

/**
 * Floating actions, bottom right on every page: back to top (shown after
 * scrolling) and WhatsApp. Both are real links, so they work without
 * JavaScript (#top scrolls to the top of the document). Labels slide out on
 * hover/focus and Escape hides them (WCAG 1.4.13). The stack steps aside while
 * it would cover the contact form's buttons, while the mobile menu is open and,
 * on narrow screens, while the consent banner waits for an answer.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="floating" data-floating>
  <a class="float-btn float-btn--top" href="#top" data-back-to-top>
    <Icon name="arrow-up" size={20} class="float-icon" />
    <span class="float-label">{t.a11y.backToTop}</span>
    <span class="float-progress" aria-hidden="true"></span>
  </a>
  <a
    class="float-btn float-btn--whatsapp"
    href={whatsappUrl(t.contact.whatsappMessage)}
    target="_blank"
    rel="noopener"
    data-track="contact_click"
    data-track-method="whatsapp_floating"
  >
    <Icon name="whatsapp" size={24} class="float-icon" />
    <span class="float-label">
      {t.contact.whatsappCta}<span class="visually-hidden"> {t.a11y.newTab}</span>
    </span>
  </a>
</div>

<script>
  const floating = document.querySelector<HTMLElement>('[data-floating]');
  const toTop = floating?.querySelector<HTMLAnchorElement>('[data-back-to-top]');

  if (floating && toTop) {
    const update = () => toTop.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
    update();
    window.addEventListener('scroll', update, { passive: true });

    toTop.addEventListener('click', (event) => {
      event.preventDefault();
      // Smooth unless the visitor prefers reduced motion (html scroll-behavior).
      window.scrollTo({ top: 0 });
      // The button hides at the top: move focus to the start of the page.
      const start = document.querySelector<HTMLElement>('.site-header .logo') ?? document.getElementById('main');
      start?.focus({ preventScroll: true });
    });

    // Escape hides the hover/focus labels until the pointer or focus leaves.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') floating.classList.add('is-dismissed');
    });
    floating.addEventListener('pointerleave', () => floating.classList.remove('is-dismissed'));
    floating.addEventListener('focusout', () => floating.classList.remove('is-dismissed'));

    // Step aside while the stack would cover the form's own buttons (email and
    // WhatsApp): on narrow screens they span the whole width.
    const formButtons = document.querySelector<HTMLElement>('[data-contact-form] .submit-group');
    if (formButtons) {
      let frame = 0;
      const checkOverlap = () => {
        frame = 0;
        const a = formButtons.getBoundingClientRect();
        const b = floating.getBoundingClientRect();
        const overlaps = a.right > b.left && a.left < b.right && a.bottom > b.top && a.top < b.bottom;
        floating.classList.toggle('is-muted', overlaps);
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(checkOverlap);
      };
      schedule();
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
    }
  }
</script>

<style>
  .floating {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    justify-items: end;
    gap: 8px;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s;
  }

  /* Hidden states delay `visibility` so the fade-out can play. */
  .floating.is-muted,
  :global(body:has(.site-header.is-open)) .floating {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }

  @media (max-width: 540px) {
    :global(body:has([data-consent]:not([hidden]))) .floating {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease),
        visibility 0s linear 0.3s;
    }
  }

  .float-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    pointer-events: auto;
    text-decoration: none;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.55);
    transition:
      opacity 0.3s var(--ease),
      visibility 0s,
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      translate 0.3s var(--ease);
  }

  .float-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .float-btn--whatsapp {
    background: var(--ink);
    color: var(--on-ink);
    /* Keeps the edge visible over the black footer. */
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.22),
      0 14px 30px -14px rgb(0 0 0 / 0.55);
  }

  .float-btn--whatsapp:hover {
    background: #2d2d2d;
  }

  .float-btn--top {
    border: 1.5px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
  }

  .float-btn--top:hover {
    background: var(--ink);
    color: var(--on-ink);
  }

  /* Hidden near the top of the page (only with JS: without it, always shown). */
  :global(.js) .float-btn--top:not(.is-visible) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s,
      translate 0.3s var(--ease);
  }

  /* Label that slides out to the left. Reduced motion: it only fades. The
     transparent border bridges the gap to the button, so the label stays
     hoverable (WCAG 1.4.13). */
  .float-label {
    position: absolute;
    top: 50%;
    right: 100%;
    padding: 9px 12px;
    border-right: 8px solid transparent;
    background: var(--ink) padding-box;
    color: var(--on-ink);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    translate: 0 -50%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease);
  }

  .float-btn:focus-visible .float-label {
    opacity: 1;
    pointer-events: auto;
  }

  @media (hover: hover) {
    .float-btn:hover .float-label {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .floating.is-dismissed .float-label {
    opacity: 0;
    pointer-events: none;
  }

  .float-progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .floating {
      animation: float-in 0.7s var(--ease) 0.6s backwards;
    }

    :global(.js) .float-btn--top:not(.is-visible) {
      translate: 0 12px;
    }

    .float-btn:hover {
      translate: 0 -2px;
    }

    .float-btn :global(.float-icon) {
      transition: transform 0.35s var(--ease);
    }

    .float-btn--top:hover :global(.float-icon) {
      transform: translateY(-3px);
    }

    .float-btn--whatsapp:hover :global(.float-icon) {
      transform: rotate(-8deg) scale(1.08);
    }

    .float-label {
      clip-path: inset(0 0 0 100%);
      transition:
        opacity 0.2s var(--ease),
        clip-path 0.35s var(--ease);
    }

    .float-btn:focus-visible .float-label {
      clip-path: inset(0);
    }

    @media (hover: hover) {
      .float-btn:hover .float-label {
        clip-path: inset(0);
      }
    }

    .floating.is-dismissed .float-label {
      clip-path: inset(0 0 0 100%);
    }

    /* Reading progress along the bottom edge of the back-to-top button. */
    @supports (animation-timeline: scroll()) {
      .float-progress {
        position: absolute;
        inset: auto -1.5px -1.5px;
        display: block;
        height: 3px;
        background: currentColor;
        transform-origin: left;
        animation: float-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }

  @keyframes float-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 640px) {
    .float-btn {
      width: 48px;
      height: 48px;
    }
  }
</style>
