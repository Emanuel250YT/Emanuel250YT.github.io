---
import ProjectCover from '@/components/projects/ProjectCover.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { projects } from '@/data/projects';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeader index={index} eyebrow={t.projects.eyebrow} title={t.projects.title} titleId="projects-title" />

    <ul class="grid" role="list" data-reveal-stagger>
      {
        projects.map((project) => (
          <li data-reveal>
            <article class:list={['card', { 'card--linked': project.url }]} aria-labelledby={`project-${project.id}`}>
              <div class="media">
                <ProjectCover kind={project.cover} locale={locale} />
                {project.url && (
                  <span class="go" aria-hidden="true">
                    <Icon name="arrow-up-right" size={16} />
                  </span>
                )}
              </div>
              <div class="head">
                <h3 id={`project-${project.id}`} class="name">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener"
                      class="stretched"
                      aria-describedby={`project-${project.id}-link`}
                    >
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h3>
                <p class="tagline">{project.tagline[locale]}</p>
              </div>
              {/* Kept out of the <h3> so the heading reads as the project name only. */}
              {project.url && (
                <span id={`project-${project.id}-link`} class="visually-hidden">
                  {t.projects.visit} {t.a11y.newTab}
                </span>
              )}
              <ul class="tags" role="list">
                {project.tags[locale].map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <p class="desc">{project.description[locale]}</p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="cta-row" data-reveal>
      <p>{t.projects.ctaTitle}</p>
      <a class="btn btn--solid" href="#contact" data-track="cta_click" data-track-location="projects">
        {t.nav.cta}
        <Icon name="arrow-right" size={18} class="btn-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(48px, 6vw, 72px);
    padding: clamp(20px, 3vw, 28px) clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .cta-row p {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: var(--tracking-display);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 48px) clamp(16px, 2.2vw, 28px);
    margin: 0;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .media {
    position: relative;
    overflow: hidden;
  }

  .go {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-card);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .card--linked:hover .go,
  .card--linked:focus-within .go {
    opacity: 1;
    transform: none;
  }

  .card--linked:hover .media :global(.cover > *) {
    transform: scale(1.04);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 12px;
    margin-top: 16px;
  }

  .name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .name a {
    text-decoration: none;
  }

  /* The whole card is clickable without nesting content inside the <a>. */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stretched:focus-visible {
    outline: none;
  }

  .card:has(.stretched:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .tagline {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 6px 0 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .desc {
    margin-top: 12px;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
