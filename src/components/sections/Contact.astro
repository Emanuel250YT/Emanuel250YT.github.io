---
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import RichHeading from '@/components/ui/RichHeading.astro';
import { useTranslations } from '@/i18n';
import { localePath, type Locale } from '@/i18n/locales';
import { cvPdfPath } from '@/lib/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div>
      <RichHeading id="contact-title" class="contact-title" parts={t.contact.title} />
      <p class="contact-text">{t.contact.body}</p>
      <div class="actions">
        <a class="btn btn--frame" href={mailto}>
          <Icon name="chat" />
          {t.contact.ctaTalk}
        </a>
        <a class="btn btn--solid" href={cvPdfPath(locale)} download type="application/pdf">
          <Icon name="file" />
          {t.contact.ctaCv}
        </a>
      </div>
      <p class="cv-alt">
        <a href={localePath(locale, 'cv')}>{t.cv.heading} (HTML)</a>
      </p>
    </div>

    <figure class="terminal">
      <div class="terminal-bar" aria-hidden="true">
        <span class="lights"><i></i><i></i><i></i></span>
        <span>{t.contact.terminalTitle}</span>
      </div>
      <div class="terminal-body">
        {
          t.contact.terminalLines.map((line) =>
            line.prompt ? (
              <p class="cmd">
                <span aria-hidden="true">$ </span>
                {line.text}
              </p>
            ) : (
              <p class="out">{line.text}</p>
            ),
          )
        }
        <p class="cmd"><span aria-hidden="true">$ </span><span class="caret" aria-hidden="true"></span></p>
      </div>
    </figure>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .contact :global(.contact-title) {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: var(--leading-hero);
  }

  .contact-text {
    max-width: 30rem;
    margin-top: 22px;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .cv-alt {
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .cv-alt a:hover {
    color: var(--ink);
  }

  .terminal {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: #e8e8e8;
    box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.5);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: var(--dark-2);
    border-bottom: 1px solid var(--on-dark-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--on-dark-soft);
  }

  .lights {
    display: flex;
    gap: 6px;
  }

  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3a3a;
  }

  .terminal-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 280px;
    padding: clamp(20px, 3vw, 32px);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.1vw, 0.9rem);
    line-height: 1.6;
  }

  .cmd {
    color: #fff;
  }

  .cmd span[aria-hidden] {
    color: #93c5fd;
  }

  .out {
    margin-bottom: 8px;
    color: #a3a3a3;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: #e8e8e8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
