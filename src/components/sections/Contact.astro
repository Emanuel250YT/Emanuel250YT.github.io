---
import { site } from '@/config/site';
import ContactForm from '@/components/contact/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';
import { cvPdfPath } from '@/lib/cv';
import { whatsappUrl } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-info">
      <SectionHeader index={index} eyebrow={t.contact.eyebrow} title={t.contact.title} titleId="contact-title" intro={t.contact.body} />

      <div class="next" data-reveal>
        <h3 class="next-title">{t.contact.nextTitle}</h3>
        <ol role="list" data-reveal-stagger>
          {
            t.contact.nextSteps.map((step, position) => (
              <li data-reveal>
                <span class="next-number" aria-hidden="true">
                  {position + 1}
                </span>
                {step}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="direct" data-reveal>
        <h3 class="next-title">{t.contact.directTitle}</h3>
        <ul role="list">
          <li>
            <a class="link-arrow" href={mailto} data-track="contact_click" data-track-method="email">
              <Icon name="mail" size={18} />
              {site.email}
            </a>
          </li>
          <li>
            <a
              class="link-arrow"
              href={whatsappUrl(t.contact.whatsappMessage)}
              target="_blank"
              rel="noopener"
              data-track="contact_click"
              data-track-method="whatsapp"
            >
              <Icon name="whatsapp" size={18} />
              <span class="visually-hidden">WhatsApp: </span>
              {site.whatsapp.display}
              <span class="visually-hidden"> {t.a11y.newTab}</span>
            </a>
          </li>
          <li>
            <a
              class="link-arrow"
              href={site.socials.linkedin}
              target="_blank"
              rel="noopener"
              data-track="contact_click"
              data-track-method="linkedin"
            >
              <Icon name="linkedin" size={16} />
              LinkedIn
              <span class="visually-hidden"> {t.a11y.newTab}</span>
            </a>
          </li>
          <li>
            <a
              class="link-arrow"
              href={cvPdfPath(locale)}
              download
              type="application/pdf"
              data-track="cv_download"
              data-track-location="contact"
            >
              <Icon name="download" size={18} />
              {t.contact.ctaCv}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <ContactForm locale={locale} />
  </div>
</section>

<style>
  .contact {
    position: relative;
    background:
      linear-gradient(to top right, color-mix(in srgb, var(--ink) 5%, transparent), transparent 45%),
      var(--bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(40px, 6vw, 88px);
  }

  .contact-info :global(.section-header) {
    margin-bottom: 20px;
  }

  .next,
  .direct {
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }

  .next-title {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .next ol {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .next li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 0.95rem;
  }

  .next-number {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    translate: 0 2px;
  }

  .direct ul {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  .direct .link-arrow {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
