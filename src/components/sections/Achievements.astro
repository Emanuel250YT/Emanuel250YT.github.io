---
import HighlightGrid from '@/components/achievements/HighlightGrid.astro';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import Marquee from '@/components/ui/Marquee.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { ecosystems } from '@/data/ecosystems';
import { achievements, achievementsAndCertifications, community } from '@/data/highlights';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<section id="achievements" class="section achievements" aria-labelledby="achievements-title">
  <div class="frames" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="container">
    <SectionHeader
      index={index}
      eyebrow={t.achievements.eyebrow}
      title={t.achievements.title}
      titleId="achievements-title"
    />
    <HighlightGrid
      locale={locale}
      label={achievements.length > 0 ? t.achievements.highlightsLabel : t.achievements.certificationsLabel}
      labelId="highlights-label"
      items={achievementsAndCertifications}
    />
  </div>

  <!-- Ecosystems strip: infinite carousel, paused while a name is pointed at. Its label
       is for screen readers only: the owner removed the visible one (it blurred the message). -->
  <div class="ecosystems">
    <p class="visually-hidden" id="ecosystems-label">{t.achievements.ecosystemsLabel}</p>
    <Marquee labelledby="ecosystems-label" duration="32s" class="ecosystems-strip">
      {
        ecosystems.map((ecosystem) => (
          <li class="ecosystem">
            {'mask' in ecosystem ? (
              <BrandLogo mask={ecosystem.mask} />
            ) : (
              <BrandLogo icon={ecosystem.icon} ratio={ecosystem.ratio} />
            )}
            {ecosystem.name}
          </li>
        ))
      }
    </Marquee>
  </div>

  <!-- Talks, hackathons and events, under the strip of the communities behind them. -->
  <div class="container community">
    <HighlightGrid locale={locale} label={t.achievements.communityLabel} labelId="community-label" items={community} />
  </div>
</section>

<style>
  .achievements {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* Faint background squares, where the design had rings (the design is square). */
  .frames {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .frames i {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--ink) 5%, transparent);
    translate: -50% -50%;
  }

  .frames i:nth-child(1) {
    top: 70%;
    left: 8%;
    width: 360px;
  }

  .frames i:nth-child(2) {
    top: 30%;
    left: 92%;
    width: 440px;
  }

  .frames i:nth-child(3) {
    top: 120%;
    left: 50%;
    width: 640px;
    border-color: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .ecosystems,
  .community {
    margin-top: clamp(48px, 6vw, 80px);
  }

  /* Logos and names rest at 0.7 on the light background (5:1 contrast for ink-2 on --bg). */
  .ecosystems :global(.ecosystems-strip) {
    --marquee-gap: clamp(40px, 5vw, 72px);
    --marquee-rest: 0.7;
    border-block: 1px solid var(--line);
    color: var(--ink);
  }

  .ecosystem {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 14px;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    color: var(--ink-2);
  }
</style>
