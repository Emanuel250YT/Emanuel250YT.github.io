---
import RichHeading from '@/components/ui/RichHeading.astro';
import { sortedAchievements } from '@/data/achievements';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';
import { formatMonth } from '@/lib/format';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="achievements" class="section achievements" aria-labelledby="achievements-title">
  <div class="rings" aria-hidden="true"></div>
  <div class="container">
    <RichHeading id="achievements-title" class="achievements-title" parts={t.achievements.title} />
  </div>

  <!-- Scrollable region reachable by keyboard (WCAG 2.1.1) -->
  <div class="rail" role="region" aria-label={t.a11y.scrollHint} tabindex="0">
    <ol class="track" role="list">
      {
        sortedAchievements.map((item) => (
          <li class="card">
            <div class="top">
              <span class="mark" aria-hidden="true">
                {item.mark}
              </span>
              <time datetime={item.date}>{formatMonth(item.date, locale)}</time>
            </div>
            <h3 class="title">{item.title[locale]}</h3>
            <p class="detail">{item.detail[locale]}</p>
            <p class="org">{item.org}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .achievements {
    position: relative;
    overflow: hidden;
  }

  /* Faint background rings, like the shapes in the design */
  .rings {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 8% 70%, transparent 179px, rgb(17 17 17 / 0.05) 180px, transparent 181px),
      radial-gradient(circle at 92% 30%, transparent 219px, rgb(17 17 17 / 0.05) 220px, transparent 221px),
      radial-gradient(circle at 50% 120%, transparent 319px, rgb(17 17 17 / 0.04) 320px, transparent 321px);
  }

  .achievements :global(.achievements-title) {
    position: relative;
    max-width: 40rem;
    margin: 0 auto clamp(40px, 5vw, 56px);
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    text-align: center;
  }

  .rail {
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2));
    position: relative;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: thin;
    scrollbar-color: rgb(17 17 17 / 0.25) transparent;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .rail:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .track {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 4px var(--edge) 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: clamp(240px, 24vw, 280px);
    min-height: 236px;
    padding: 22px;
    border-radius: 4px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    scroll-snap-align: start;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .mark {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding-inline: 6px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  time {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .detail {
    margin-top: 8px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .org {
    margin-top: auto;
    padding-top: 22px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
  }
</style>
