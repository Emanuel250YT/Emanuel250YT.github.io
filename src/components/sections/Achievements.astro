---
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { sortedAchievements } from '@/data/achievements';
import { ecosystems } from '@/data/contact';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';
import { formatMonth } from '@/lib/format';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<section id="achievements" class="section achievements" aria-labelledby="achievements-title">
  <div class="frames" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="container">
    <SectionHeader
      index={index}
      eyebrow={t.achievements.eyebrow}
      title={t.achievements.title}
      titleId="achievements-title"
      layout="center"
    />
  </div>

  <!-- Scrollable region reachable by keyboard (WCAG 2.1.1) -->
  <div class="rail" role="region" aria-label={t.a11y.scrollHint} tabindex="0">
    <ol class="track" role="list" data-reveal-stagger>
      {
        sortedAchievements.map((item) => (
          <li class="card" data-reveal>
            <div class="top">
              <span class="mark" aria-hidden="true">
                {item.mark}
              </span>
              <time datetime={item.date}>{formatMonth(item.date, locale)}</time>
            </div>
            <h3 class="title">{item.title[locale]}</h3>
            <p class="detail">{item.detail[locale]}</p>
            <div class="foot">
              <p class="org">{item.org}</p>
              {item.url && (
                <a class="source link-arrow" href={item.url} target="_blank" rel="noopener">
                  {t.achievements.source}
                  <span class="visually-hidden">
                    : {item.title[locale]} {t.a11y.newTab}
                  </span>
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Ecosystems strip: it moves with the page scroll (no autoplay), where scroll-driven animations exist. -->
  <div class="ecosystems">
    <p class="container ecosystems-label">{t.achievements.ecosystemsLabel}</p>
    <div class="marquee">
      <ul class="marquee-track" role="list">
        {ecosystems.map((name) => <li>{name}</li>)}
      </ul>
      <ul class="marquee-track" role="list" aria-hidden="true">
        {ecosystems.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .achievements {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* Faint background squares, where the design had rings (the design is square). */
  .frames {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .frames i {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid rgb(17 17 17 / 0.05);
    translate: -50% -50%;
  }

  .frames i:nth-child(1) {
    top: 70%;
    left: 8%;
    width: 360px;
  }

  .frames i:nth-child(2) {
    top: 30%;
    left: 92%;
    width: 440px;
  }

  .frames i:nth-child(3) {
    top: 120%;
    left: 50%;
    width: 640px;
    border-color: rgb(17 17 17 / 0.04);
  }

  .ecosystems {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .ecosystems-label {
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: center;
  }

  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    flex: none;
    gap: clamp(32px, 5vw, 64px);
    margin: 0;
    padding: 22px clamp(16px, 2.5vw, 32px);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    color: var(--ink-2);
  }

  .marquee-track li {
    display: flex;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .marquee-track li::after {
    content: '✦';
    font-size: 0.7em;
    color: var(--muted);
  }

  /* Scroll-linked: the strip slides while the section crosses the viewport. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .marquee-track {
        animation: marquee linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-60%);
    }
  }

  .rail {
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2));
    position: relative;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: thin;
    scrollbar-color: rgb(17 17 17 / 0.25) transparent;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .rail:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .track {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 4px var(--edge) 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: clamp(240px, 24vw, 280px);
    min-height: 236px;
    padding: 22px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    scroll-snap-align: start;
    transition:
      translate 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .card:hover {
    translate: 0 -4px;
    box-shadow: var(--shadow-card);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .mark {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding-inline: 6px;
    border: 1.5px solid var(--ink);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  time {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .detail {
    margin-top: 8px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    margin-top: auto;
    padding-top: 22px;
  }

  .org {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  /* Target size >= 24 px (WCAG 2.5.8): .link-arrow already sets min-height. */
  .source {
    gap: 4px;
    font-size: 0.75rem;
  }
</style>
