---
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<section id="process" class="section process" aria-labelledby="process-title">
  <div class="container">
    <SectionHeader
      index={index}
      eyebrow={t.process.eyebrow}
      title={t.process.title}
      titleId="process-title"
      intro={t.process.intro}
      layout="split"
    />

    <ol class="steps" role="list" data-reveal="fade" data-reveal-stagger>
      {
        t.process.steps.map((step, position) => (
          <li class="step" data-reveal>
            <div class="step-top" aria-hidden="true">
              <span class="marker">{String(position + 1).padStart(2, '0')}</span>
              {position < t.process.steps.length - 1 && <Icon name="arrow-right" size={22} class="next" />}
            </div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="cta-row" data-reveal>
      <a class="btn btn--solid" href="#contact" data-track="cta_click" data-track-location="process">
        <Icon name="calendar" size={18} />
        {t.process.cta}
        <Icon name="arrow-right" size={18} class="btn-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .process {
    border-block: 1px solid var(--line);
    background:
      linear-gradient(to bottom left, rgb(17 17 17 / 0.04), transparent 45%),
      var(--bg);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
    margin: 0;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Numbered square and, at the far end of the column, an arrow towards the next step. */
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .step-top :global(.next) {
    flex: none;
    color: var(--ink-soft);
  }

  /* The arrow fades in after its step; with motion allowed it also slides in, and it nudges on hover. */
  :global(.js) .step.is-revealed :global(.next) {
    animation: next-in 0.6s var(--ease) 0.45s backwards;
  }

  @keyframes next-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .step.is-revealed :global(.next) {
      animation-name: next-slide;
    }

    .step-top :global(.next) {
      transition: translate 0.3s var(--ease);
    }

    .step:hover .step-top :global(.next) {
      translate: 4px 0;
    }
  }

  @keyframes next-slide {
    from {
      opacity: 0;
      translate: -12px 0;
    }
  }

  .marker {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .step:hover .marker {
    background: var(--ink);
    color: #fff;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  p {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .cta-row {
    margin-top: clamp(40px, 5vw, 56px);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Two or one columns: the next step is no longer to the right. */
    .step-top :global(.next) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
