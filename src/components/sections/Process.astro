---
import { Image } from 'astro:assets';
import build from '@/assets/process/build.jpg';
import diagnosis from '@/assets/process/diagnosis.jpg';
import launch from '@/assets/process/launch.jpg';
import proposal from '@/assets/process/proposal.jpg';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
// Same order as `process.steps` in every dictionary (sources and prompts: assets-src/process).
const images = [
  { id: 'diagnosis', src: diagnosis },
  { id: 'proposal', src: proposal },
  { id: 'build', src: build },
  { id: 'launch', src: launch },
] as const;
const number = (position: number) => String(position + 1).padStart(2, '0');
---

<section id="process" class="section process" aria-labelledby="process-title">
  <!-- Four views. On wide, tall enough screens (with JS) the stage, section title
       included, stays pinned while the page scrolls through it and shows one view at a
       time; otherwise they stack under the title. -->
  <div class="journey" data-journey style={`--views: ${t.process.steps.length}`}>
    <div class="container stage" data-journey-stage>
      <SectionHeader
        index={index}
        eyebrow={t.process.eyebrow}
        title={t.process.title}
        titleId="process-title"
        intro={t.process.intro}
        layout="split"
      />
      <ol class="progress" role="list" aria-hidden="true">
        {
          t.process.steps.map((step, position) => (
            <li data-journey-dot>
              <span class="progress-mark" />
              <span class="progress-number">{number(position)}</span>
              {step.title}
            </li>
          ))
        }
      </ol>

      <ol class="views" role="list">
        {
          t.process.steps.map((step, position) => (
            <li class="view" data-view>
              {/* Decorative: the copy next to it says what happens in the step. */}
              <div class="visual">
                <Image
                  src={images[position]!.src}
                  alt=""
                  widths={[480, 720, 960, 1280]}
                  sizes="(max-width: 899px) calc(100vw - 32px), 620px"
                  loading="lazy"
                  class="photo"
                />
              </div>
              <div class="copy">
                <span class="marker" aria-hidden="true">
                  {number(position)}
                </span>
                <h3>{step.title}</h3>
                <p class="body">{step.body}</p>
                <p class="label">{t.process.actionsLabel}</p>
                <ul class="actions" role="list">
                  {step.actions.map((action, item) => (
                    <li style={`--d: ${0.25 + item * 0.12}s`}>
                      <span class="check" aria-hidden="true">
                        <Icon name="check" size={14} />
                      </span>
                      {action}
                    </li>
                  ))}
                </ul>
                <a
                  class="btn btn--solid cta"
                  href="#contact"
                  data-track="cta_click"
                  data-track-location={`process_${images[position]!.id}`}
                >
                  <Icon name="calendar" size={18} />
                  {t.process.cta}
                  <Icon name="arrow-right" size={18} class="btn-arrow" />
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <!-- Pinned layout only: the scroll distance the stage stays pinned for. -->
    <div class="runway" aria-hidden="true"></div>
  </div>
</section>

<script>
  /**
   * Pinned layout: the active view follows how far the page has scrolled through the
   * journey (each view gets an equal share). Stacked layout: each view plays its
   * entrance once, when it shows up. The media query matches the CSS one.
   */
  const journey = document.querySelector<HTMLElement>('[data-journey]');
  const stage = journey?.querySelector<HTMLElement>('[data-journey-stage]');
  if (journey && stage) {
    const views = [...journey.querySelectorAll<HTMLElement>('[data-view]')];
    const dots = [...journey.querySelectorAll<HTMLElement>('[data-journey-dot]')];
    const pinned = window.matchMedia('(min-width: 900px) and (min-height: 700px)');
    let active = -1;
    let frame = 0;

    const show = (index: number) => {
      if (index === active) return;
      active = index;
      views.forEach((view, position) => {
        view.classList.toggle('is-active', position === index);
        if (position === index) view.setAttribute('aria-current', 'step');
        else view.removeAttribute('aria-current');
      });
      dots.forEach((dot, position) => {
        dot.classList.toggle('is-active', position === index);
        dot.classList.toggle('is-done', position < index);
      });
    };

    // The stage sticks at its CSS `top`; the runway below it is the distance it stays pinned.
    const pinnedAt = () => parseFloat(getComputedStyle(stage).top) || 0;
    const runway = () => journey.offsetHeight - stage.offsetHeight;

    // While pinned, the stage sits centred in the space under the header (`--pin-top`).
    // It keeps its own height, so on the way in it still follows the section title closely.
    const header = document.querySelector<HTMLElement>('[data-header]');
    const centre = () => {
      if (!pinned.matches) return;
      const headerHeight = header?.offsetHeight ?? 64;
      const free = window.innerHeight - headerHeight - stage.offsetHeight;
      stage.style.setProperty('--pin-top', `${Math.round(headerHeight + Math.max(12, free / 2))}px`);
    };
    new ResizeObserver(() => {
      centre();
      schedule();
    }).observe(stage);

    const update = () => {
      frame = 0;
      if (!pinned.matches) return;
      const distance = runway();
      const progress = distance > 0 ? (pinnedAt() - journey.getBoundingClientRect().top) / distance : 0;
      show(Math.min(views.length - 1, Math.max(0, Math.floor(progress * views.length))));
    };
    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    // Tabbing to the button of a hidden view scrolls to the middle of its share, so the
    // focused button is always on screen.
    views.forEach((view, position) => {
      view.addEventListener('focusin', () => {
        if (!pinned.matches || position === active) return;
        const top = journey.getBoundingClientRect().top + window.scrollY - pinnedAt();
        window.scrollTo({ top: top + (runway() * (position + 0.5)) / views.length, behavior: 'instant' });
        show(position);
      });
    });

    const stacked = new IntersectionObserver(
      (entries) => {
        if (pinned.matches) return;
        for (const entry of entries) if (entry.isIntersecting) entry.target.classList.add('is-active');
      },
      { threshold: 0.25 },
    );
    views.forEach((view) => stacked.observe(view));

    pinned.addEventListener('change', () => {
      active = -1;
      if (pinned.matches) {
        centre();
        update();
      } else views.forEach((view) => (view.removeAttribute('aria-current'), view.classList.add('is-active')));
    });
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => {
      centre();
      schedule();
    });
    centre();
    update();
  }
</script>

<style>
  .process {
    border-block: 1px solid var(--line);
    background:
      linear-gradient(to bottom left, color-mix(in srgb, var(--ink) 4%, transparent), transparent 45%),
      var(--bg);
  }

  /* Stacked layout (default, no JS, narrow or short screens). */
  .progress {
    display: none;
  }

  .views {
    display: grid;
    gap: clamp(40px, 6vw, 64px);
    margin: 0;
  }

  .view {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
  }

  .visual {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--backdrop);
  }

  .visual :global(.photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slightly dimmed in the dark theme so the light desks do not glare. */
    filter: var(--photo-filter);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cta {
    margin-top: 24px;
  }

  .marker {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border: 1.5px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .body {
    max-width: 30rem;
    margin-top: 8px;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .label {
    margin-top: 20px;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .actions {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .actions li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.98rem;
    font-weight: 500;
  }

  .check {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    background: var(--ink);
    color: var(--on-ink);
  }

  /* The copy of a view plays in when it becomes active (JS only). */
  :global(.js) .view .copy > *,
  :global(.js) .view .actions li {
    opacity: 0;
  }

  :global(.js) .view.is-active .copy > *,
  :global(.js) .view.is-active .actions li {
    opacity: 1;
    animation: copy-fade 0.5s var(--ease) backwards;
  }

  :global(.js) .view.is-active .actions li {
    animation-delay: var(--d);
  }

  @keyframes copy-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .view.is-active .copy > *,
    :global(.js) .view.is-active .actions li {
      animation-name: copy-rise;
    }

    /* The photo settles in from a slight zoom when its view becomes active. */
    :global(.js) .view.is-active :global(.photo) {
      animation: photo-settle 1.2s var(--ease) backwards;
    }
  }

  @keyframes photo-settle {
    from {
      scale: 1.06;
    }
  }

  @keyframes copy-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  .runway {
    display: none;
  }

  /* Pinned layout: the stage (section title, progress and views) keeps its own height
     and, once pinned, sits centred under the header: the script sets `--pin-top` from
     its height. The title stays on screen through the four views. The runway after it
     adds one share of scroll per extra view. The views share one cell. */
  @media (min-width: 900px) and (min-height: 700px) {
    :global(.js) .journey {
      --stage-h: calc(100svh - var(--header-h));
    }

    :global(.js) .stage {
      position: sticky;
      top: var(--pin-top, calc(var(--header-h) + clamp(12px, 3vh, 28px)));
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    :global(.js) .stage :global(.section-header) {
      margin-bottom: 4px;
    }

    :global(.js) .runway {
      display: block;
      height: calc((var(--views) - 1) * 60svh);
    }

    :global(.js) .progress {
      display: grid;
      grid-template-columns: repeat(var(--views), minmax(0, 1fr));
      gap: 16px;
      margin: 0;
    }

    :global(.js) .progress li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--ink-soft);
      transition: color 0.3s var(--ease);
    }

    :global(.js) .progress li.is-active {
      color: var(--ink);
    }

    :global(.js) .progress-mark {
      flex: none;
      width: 12px;
      height: 12px;
      border: 1.5px solid currentColor;
      transition: background-color 0.3s var(--ease);
    }

    :global(.js) .progress li.is-active .progress-mark,
    :global(.js) .progress li.is-done .progress-mark {
      background: currentColor;
    }

    :global(.js) .progress-number {
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }

    :global(.js) .views {
      display: grid;
    }

    :global(.js) .view {
      grid-area: 1 / 1;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease);
    }

    :global(.js) .view.is-active,
    :global(.js) .view:focus-within {
      opacity: 1;
      pointer-events: auto;
    }

    /* Keep the whole stage (title, progress and a 4:3 photo) inside the viewport on
       shorter screens: the photo column shrinks with the height, the copy takes the rest. */
    :global(.js) .view {
      grid-template-columns: min(55%, (var(--stage-h) - 300px) * 4 / 3) minmax(0, 1fr);
    }
  }

  @media (max-width: 899px) {
    .view {
      grid-template-columns: 1fr;
    }
  }

  /* Printed: the four views one after another, fully drawn. */
  @media print {
    :global(.js) .runway {
      display: none;
    }

    :global(.js) .stage {
      position: static;
    }

    :global(.js) .progress {
      display: none;
    }

    :global(.js) .views {
      gap: 48px;
    }

    :global(.js) .view {
      grid-area: auto;
      opacity: 1;
      break-inside: avoid;
    }

    :global(.js) .view .copy > *,
    :global(.js) .view .actions li {
      opacity: 1;
      animation: none;
    }
  }
</style>
