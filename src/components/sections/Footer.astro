---
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar.png';
import { site } from '@/config/site';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { localePath, type Locale } from '@/i18n/locales';
import { whatsappUrl } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const analyticsEnabled = Boolean(site.googleAnalyticsId || site.googleTagManagerId);
const home = localePath(locale);

const socials: { label: string; href: string; icon: IconName }[] = [
  { label: 'github', href: site.socials.github, icon: 'github' },
  { label: 'linkedin', href: site.socials.linkedin, icon: 'linkedin' },
  { label: 'npm', href: site.socials.npm, icon: 'npm' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="logo">{site.logo}</p>
      <p class="tagline">{t.footer.tagline}</p>
      <ul class="socials" role="list">
        {
          socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="me noopener">
                <Icon name={social.icon} size={15} />
                {social.label}
                <span class="visually-hidden"> {t.a11y.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reach">
      <p class="cta-title">{t.footer.ctaTitle}</p>
      <a class="btn btn--light" href={`${home}#contact`} data-track="cta_click" data-track-location="footer">
        {t.nav.cta}
        <Icon name="arrow-right" size={18} class="btn-arrow" />
      </a>
      <div class="channels">
        <a class="channel" href={`mailto:${site.email}`} data-track="contact_click" data-track-method="email_footer">
          <Image src={avatar} alt="" width={30} height={30} densities={[1, 2]} class="channel-avatar" />
          {site.email}
        </a>
        <a
          class="channel"
          href={whatsappUrl(t.contact.whatsappMessage)}
          target="_blank"
          rel="noopener"
          data-track="contact_click"
          data-track-method="whatsapp_footer"
        >
          <span class="channel-icon"><Icon name="whatsapp" size={16} /></span>
          <span class="visually-hidden">WhatsApp: </span>
          {site.whatsapp.display}
          <span class="visually-hidden"> {t.a11y.newTab}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}. {t.footer.rights}</p>
    <ul class="legal" role="list">
      <li><a href={localePath(locale, 'privacy')}>{t.privacy.heading}</a></li>
      {
        analyticsEnabled && (
          <li>
            <button type="button" class="link-button" data-consent-open>
              {t.footer.cookies}
            </button>
          </li>
        )
      }
    </ul>
    <p class="built">{t.footer.builtWith}</p>
  </div>
</footer>

<style>
  /* Plain black: no gradients or glows, only the links. */
  .site-footer {
    background: #000;
    color: var(--on-dark);
    padding-top: clamp(48px, 6vw, 72px);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 8px;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0 0;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid rgb(255 255 255 / 0.55);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .socials a:hover {
    background: #fff;
    color: #000;
  }

  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .cta-title {
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    letter-spacing: var(--tracking-display);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 18px;
    margin: 4px 0;
  }

  /* The link and the button share one box, so their text lines up. */
  .legal a,
  .link-button {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0;
    line-height: 1.2;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8rem;
    color: var(--on-dark-soft);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 0.25em;
  }

  .legal a:hover,
  .link-button:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .channel {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 18px 6px 6px;
    background: #fff;
    color: #000;
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: translate 0.2s var(--ease);
  }

  .channel:hover {
    translate: 0 -2px;
  }

  .channel :global(.channel-avatar),
  .channel-icon {
    flex: none;
    width: 30px;
    height: 30px;
    object-fit: cover;
  }

  .channel-icon {
    display: grid;
    place-items: center;
    background: #000;
    color: #fff;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: clamp(48px, 7vw, 88px);
    padding-block: 20px 28px;
    text-align: center;
    font-size: 0.8rem;
    color: var(--on-dark-soft);
  }

  .built {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 640px) {
    .reach {
      align-items: flex-start;
    }

    .channels {
      justify-content: flex-start;
    }

    /* Room for the floating buttons at the end of the page. */
    .bottom {
      padding-bottom: 140px;
    }
  }
</style>
