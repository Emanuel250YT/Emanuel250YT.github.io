---
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import { useTranslations } from '@/i18n';
import { localePath, type Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const isHome = path === '';
const target = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);

const links = [
  { id: 'about', label: t.nav.about },
  { id: 'services', label: t.nav.services },
  { id: 'process', label: t.nav.process },
  { id: 'projects', label: t.nav.projects },
  { id: 'achievements', label: t.nav.achievements },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="logo" href={isHome ? '#home' : home}>
      {site.logo}<span class="visually-hidden"> {site.name}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden" data-label-open>{t.a11y.menu}</span>
      <span class="visually-hidden" data-label-close hidden>{t.a11y.closeMenu}</span>
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t.a11y.primaryNav}>
      <ul role="list" class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={target(link.id)} data-nav-link={link.id}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <a
          class="btn btn--solid btn--sm nav-cta"
          href={target('contact')}
          data-track="cta_click"
          data-track-location="header"
        >
          {t.nav.cta}
          <Icon name="arrow-right" size={16} class="btn-arrow" />
        </a>
        <LanguageSwitcher locale={locale} path={path} />
      </div>
    </nav>
  </div>
  <noscript>
    <style>
      .site-header .nav {
        visibility: visible !important;
        opacity: 1 !important;
        transform: none !important;
        position: static !important;
      }
      .site-header .menu-toggle {
        display: none !important;
      }
    </style>
  </noscript>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && toggle) {
    const labelOpen = toggle.querySelector<HTMLElement>('[data-label-open]');
    const labelClose = toggle.querySelector<HTMLElement>('[data-label-close]');

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      labelOpen?.toggleAttribute('hidden', open);
      labelClose?.toggleAttribute('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll('.nav a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      // The language switcher handles its own Escape first (and prevents default).
      if (event.key === 'Escape' && !event.defaultPrevented && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Highlights the section currently in view (home page only).
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.navLink ?? ''))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        const [current] = [...visible.entries()].sort((a, b) => b[1] - a[1]);
        for (const link of navLinks) {
          if (current && current[1] > 0 && link.dataset.navLink === current[0]) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(243 243 243 / 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
    view-transition-name: site-header;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 8px 24px -18px rgb(0 0 0 / 0.25);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .logo {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }

  .logo:hover {
    opacity: 0.7;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 36px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.2vw, 32px);
    margin: 0;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  /* Underline that grows from the left on hover and for the active section */
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--ink);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    background: none;
    border: 0;
    cursor: var(--cursor-pointer);
  }

  /* Animated burger: three bars morph into a cross */
  .burger {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }

  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.75px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease),
      opacity 0.2s var(--ease),
      top 0.35s var(--ease);
  }

  .burger i:nth-child(1) {
    top: 0;
  }

  .burger i:nth-child(2) {
    top: 6px;
  }

  .burger i:nth-child(3) {
    top: 12px;
  }

  .site-header.is-open .burger i:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }

  .site-header.is-open .burger i:nth-child(2) {
    opacity: 0;
  }

  .site-header.is-open .burger i:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .menu-toggle {
      display: grid;
    }

    .nav {
      position: absolute;
      inset: var(--header-h) 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: 8px var(--gutter) 28px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.25);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-12px);
      transition:
        opacity 0.3s var(--ease),
        transform 0.35s var(--ease),
        visibility 0s linear 0.35s;
    }

    .site-header.is-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.3s var(--ease),
        transform 0.35s var(--ease),
        visibility 0s;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-links a {
      width: 100%;
      min-height: 52px;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--line);
    }

    .nav-links a::after {
      display: none;
    }

    .nav-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .nav-cta {
      --btn-h: 48px;
    }
  }

  @media (max-width: 1024px) and (prefers-reduced-motion: reduce) {
    .nav {
      transform: none;
    }
  }
</style>
