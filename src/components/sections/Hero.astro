---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import RichHeading from '@/components/ui/RichHeading.astro';
import { useTranslations } from '@/i18n';
import { localeMeta, type Locale } from '@/i18n/locales';
import { NPM_DOWNLOADS_TOKEN, buildDownloads } from '@/lib/npm';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Real npm downloads at build time; the script below refreshes them live for the same
// packages. An offline build shows an ellipsis (scripts/verify-seo.mjs fails if a page
// ships without the number).
const npm = await buildDownloads().catch((error: unknown) => {
  console.warn(`[npm] ${error instanceof Error ? error.message : String(error)}`);
  return undefined;
});
const formatCount = new Intl.NumberFormat(localeMeta[locale].htmlLang);
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge enter" style="--enter-index: 0">
        <span class="badge-pill">
          <strong>{site.name}</strong>
          <span class="badge-sep" aria-hidden="true"></span>
          <span class="visually-hidden">{t.a11y.rolesLabel}: {t.hero.roles.join(', ')}</span>
          <!-- Rotating role, typed and erased by the script below. Every role also sits invisible
               in the same grid cell, so the pill keeps the width of the longest one. -->
          <span class="roles" aria-hidden="true">
            {t.hero.roles.map((role) => <span class="role-size" data-role>{role}</span>)}
            <span class="role-typed" data-role-typed>{t.hero.roles[0]}</span>
          </span>
        </span>
      </p>

      <RichHeading as="h1" id="hero-title" class="hero-title" parts={t.hero.title} typeDelay={150} />

      <p class="lead enter" style="--enter-index: 2">{t.hero.lead}</p>

      <div class="actions enter" style="--enter-index: 3">
        <a class="btn btn--solid" href="#contact" data-track="cta_click" data-track-location="hero">
          {t.hero.ctaPrimary}
          <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
        <a class="btn btn--frame" href="#services" data-track="cta_click" data-track-location="hero_services">
          {t.hero.ctaSecondary}
        </a>
      </div>

      <dl class="stats enter" style="--enter-index: 4" data-count-group>
        {
          t.hero.stats.map((stat) => (
            <div class="stat">
              <dt>
                {stat.value === NPM_DOWNLOADS_TOKEN ? (
                  <span
                    class="stat-value"
                    data-count
                    data-count-value={npm?.total}
                    data-npm-total
                    data-npm-packages={npm && JSON.stringify(npm.packages)}
                  >
                    {npm ? formatCount.format(npm.total) : '…'}
                  </span>
                ) : (
                  <span class="stat-value" data-count>
                    {stat.value}
                  </span>
                )}
                <span class="stat-label">{stat.label}</span>
              </dt>
              <dd>{stat.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="hero-photo enter enter--photo" style="--enter-index: 1">
      <Image
        src={portrait}
        alt={t.hero.photoAlt}
        widths={[340, 460, 600, 744]}
        sizes="(max-width: 860px) min(80vw, 380px), 460px"
        loading="eager"
        fetchpriority="high"
        class="photo"
      />
    </figure>
  </div>
</section>

<script>
  import type { NpmPackage } from '@/data/npm';
  import { graphemes } from '@/lib/graphemes';
  import { totalDownloads } from '@/lib/npm';

  /**
   * Types the roles of the hero badge one after another: type, hold, erase, next.
   * Pauses on hover, while the hero is off-screen or the tab is hidden, and stops on
   * the first role after three cycles (WCAG 2.2.2). Only text changes and nothing
   * moves, so it runs the same with prefers-reduced-motion (the caret just stops
   * blinking). Screen readers get the full list once, statically.
   */
  const typed = document.querySelector<HTMLElement>('[data-role-typed]');
  const roles = [...document.querySelectorAll<HTMLElement>('[data-role]')].map((role) => graphemes(role.textContent ?? ''));
  if (typed && roles.length > 1) {
    const TYPE_MS = 65;
    const ERASE_MS = 32;
    const HOLD_MS = 2200;
    const GAP_MS = 320;
    const CYCLES = 3;
    let index = 0;
    let shown = roles[0]!.length;
    let cycles = 0;
    let phase: 'hold' | 'erase' | 'type' = 'hold';
    let paused = false;
    let visible = true;

    const render = () => {
      typed.textContent = roles[index]!.slice(0, shown)
        .map((character) => character.segment)
        .join('');
    };

    const step = (): void => {
      if (paused || !visible || document.hidden) {
        window.setTimeout(step, 250);
        return;
      }
      if (phase === 'hold') {
        typed.classList.remove('is-holding');
        phase = 'erase';
      }
      if (phase === 'erase') {
        shown -= 1;
        render();
        if (shown > 0) {
          window.setTimeout(step, ERASE_MS);
          return;
        }
        index = (index + 1) % roles.length;
        if (index === 0) cycles += 1;
        phase = 'type';
        window.setTimeout(step, GAP_MS);
        return;
      }
      shown += 1;
      render();
      if (shown < roles[index]!.length) {
        window.setTimeout(step, TYPE_MS);
        return;
      }
      phase = 'hold';
      typed.classList.add('is-holding');
      if (cycles >= CYCLES && index === 0) typed.classList.add('is-done');
      else window.setTimeout(step, HOLD_MS);
    };

    typed.classList.add('is-holding');
    window.setTimeout(step, HOLD_MS);

    const badge = typed.closest('.badge');
    badge?.addEventListener('mouseenter', () => (paused = true));
    badge?.addEventListener('mouseleave', () => (paused = false));
    new IntersectionObserver(([entry]) => (visible = entry?.isIntersecting ?? true)).observe(typed);
  }

  /**
   * Refreshes the npm downloads stat with today's real count once the page is idle,
   * so it never competes with the first paint. It counts the same packages as the
   * build, npm organisations included. On failure the build-time number stays.
   */
  const npmTotal = document.querySelector<HTMLElement>('[data-npm-total]');
  const npmPackages = npmTotal?.dataset.npmPackages;
  if (npmTotal && npmPackages) {
    const refresh = () =>
      totalDownloads(JSON.parse(npmPackages) as NpmPackage[])
        .then((total) => {
          npmTotal.dataset.countValue = String(total);
          // A running count-up (src/scripts/motion.ts) picks the new value up on its next frame.
          if (!('counting' in npmTotal.dataset)) {
            npmTotal.textContent = new Intl.NumberFormat(document.documentElement.lang).format(total);
          }
        })
        .catch(() => undefined);
    // Safari has no requestIdleCallback.
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(refresh, { timeout: 4000 });
    else setTimeout(refresh, 2000);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(28px, 4vw, 52px) 0;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgb(17 17 17 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 17 17 / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    overflow: hidden;
  }

  /* The grid fades out towards the bottom, as in the design */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 460px);
    align-items: end;
    gap: clamp(32px, 4.5vw, 56px);
  }

  .hero-copy {
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  /* Entrance on load, staggered. Starts at a tiny non-zero opacity so the text
     still counts as painted for Largest Contentful Paint. Reduced motion: fade only. */
  .enter {
    animation: enter-fade 0.7s var(--ease) both;
    animation-delay: calc(var(--enter-index, 0) * 90ms + 60ms);
  }

  @keyframes enter-fade {
    from {
      opacity: 0.01;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation-name: enter;
      animation-duration: 0.9s;
      animation-delay: calc(var(--enter-index, 0) * 110ms + 60ms);
    }

    .enter--photo {
      animation-name: enter-photo;
      animation-duration: 1.1s;
    }
  }

  @keyframes enter {
    from {
      opacity: 0.01;
      transform: translate3d(0, 24px, 0);
    }
  }

  @keyframes enter-photo {
    from {
      transform: translate3d(0, 48px, 0) scale(0.98);
    }
  }

  /* Badge, like the Figma label in the design */
  .badge {
    display: inline-flex;
    margin-bottom: 14px;
  }

  .badge-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px 7px 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .badge-pill strong {
    font-weight: 600;
  }

  .badge-sep,
  .roles {
    color: var(--ink-soft);
  }

  /* Small square between the name and the role (square design, no slash). */
  .badge-sep {
    flex: none;
    width: 5px;
    height: 5px;
    margin-inline: 3px;
    background: currentColor;
  }

  .roles {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Without JS the typed role simply shows the first one. The invisible copies of
     every role keep the pill as wide as the longest; the padding leaves room for the caret. */
  .roles {
    display: grid;
    padding-right: 6px;
  }

  .role-size,
  .role-typed {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .role-size {
    visibility: hidden;
  }

  .role-typed {
    position: relative;
    justify-self: start;
    min-height: 1lh;
  }

  :global(.js) .role-typed::after {
    content: '';
    position: absolute;
    top: 0.1em;
    bottom: 0.1em;
    left: calc(100% + 2px);
    width: 2px;
    background: var(--ink);
  }

  :global(.js) .role-typed.is-done::after {
    content: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .role-typed.is-holding::after {
      animation: caret-blink 1s step-end infinite;
    }
  }

  .hero :global(.hero-title) {
    font-size: clamp(2.3rem, 4.4vw, 3.75rem);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    max-width: 34rem;
    margin-top: 16px;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 32px);
    max-width: 38rem;
    margin-top: clamp(28px, 3.5vw, 40px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 12px;
    border-left: 1.5px solid var(--ink);
  }

  .stat dt {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .stat dd {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* Black & white cut-out portrait that "stands" on the dark section, as in the design.
     A square block behind it and a short shadow separate it from the light grid;
     the head rises above the block. */
  .hero-photo {
    position: relative;
    justify-self: end;
    width: 100%;
    isolation: isolate;
  }

  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 20% 2% 0 8%;
    z-index: -1;
    background: var(--backdrop);
  }

  .hero-photo :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.22));
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-photo {
      justify-self: center;
      width: min(80%, 380px);
      margin-top: 8px;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stat {
      display: grid;
      grid-template-columns: 4.75rem 1fr;
      grid-template-areas:
        'value label'
        'value detail';
      column-gap: 14px;
      row-gap: 2px;
      align-items: center;
    }

    .stat dt {
      display: contents;
    }

    .stat-value {
      grid-area: value;
    }

    .stat-label {
      grid-area: label;
    }

    .stat dd {
      grid-area: detail;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
