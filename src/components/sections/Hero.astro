---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import RichHeading from '@/components/ui/RichHeading.astro';
import { useTranslations } from '@/i18n';
import { localeMeta, type Locale } from '@/i18n/locales';
import { NPM_DOWNLOADS_TOKEN, buildTotalDownloads } from '@/lib/npm';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Real npm downloads at build time; the script below refreshes them live. An offline
// build shows a dash (scripts/verify-seo.mjs fails if a page ships without the number).
const npmTotal = await buildTotalDownloads().catch((error: unknown) => {
  console.warn(`[npm] ${error instanceof Error ? error.message : String(error)}`);
  return undefined;
});
const formatCount = new Intl.NumberFormat(localeMeta[locale].htmlLang);
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge enter" style="--enter-index: 0">
        <span class="badge-mark" aria-hidden="true">e.</span>
        <span class="badge-pill">
          <strong>{site.name}</strong>
          <span class="badge-sep" aria-hidden="true">/</span>
          <span class="visually-hidden">{t.a11y.rolesLabel}: {t.hero.roles.join(', ')}</span>
          <!-- Rotating role: every role sits in the same grid cell, so the pill keeps the width of the longest one. -->
          <span class="roles" aria-hidden="true" data-roles>
            {
              t.hero.roles.map((role, index) => (
                <span class:list={['role', { 'is-active': index === 0 }]} data-role>
                  {role}
                </span>
              ))
            }
          </span>
        </span>
      </p>

      <div class="enter" style="--enter-index: 1">
        <RichHeading as="h1" id="hero-title" class="hero-title" parts={t.hero.title} />
      </div>

      <p class="lead enter" style="--enter-index: 2">{t.hero.lead}</p>

      <div class="actions enter" style="--enter-index: 3">
        <a class="btn btn--solid" href="#contact" data-track="cta_click" data-track-location="hero">
          {t.hero.ctaPrimary}
          <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
        <a class="btn btn--frame" href="#services" data-track="cta_click" data-track-location="hero_services">
          {t.hero.ctaSecondary}
        </a>
      </div>

      <dl class="stats enter" style="--enter-index: 4" data-count-group>
        {
          t.hero.stats.map((stat) => (
            <div class="stat">
              <dt>
                {stat.value === NPM_DOWNLOADS_TOKEN ? (
                  <span class="stat-value" data-count data-count-value={npmTotal} data-npm-total>
                    {npmTotal === undefined ? '—' : formatCount.format(npmTotal)}
                  </span>
                ) : (
                  <span class="stat-value" data-count>
                    {stat.value}
                  </span>
                )}
                <span class="stat-label">{stat.label}</span>
              </dt>
              <dd>{stat.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="hero-photo enter enter--photo" style="--enter-index: 1">
      <Image
        src={portrait}
        alt={t.hero.photoAlt}
        widths={[340, 460, 600, 744]}
        sizes="(max-width: 860px) min(80vw, 380px), 460px"
        loading="eager"
        fetchpriority="high"
        class="photo"
      />
    </figure>
  </div>
</section>

<script>
  import { totalDownloads } from '@/lib/npm';

  /**
   * Rotates the roles in the hero badge. Pauses on hover/focus and while the hero
   * is off-screen and stops after a few cycles (WCAG 2.2.2). With
   * prefers-reduced-motion the roles cross-fade instead of sliding (CSS).
   * Screen readers get the full list once, statically.
   */
  const container = document.querySelector<HTMLElement>('[data-roles]');
  const roles = container ? [...container.querySelectorAll<HTMLElement>('[data-role]')] : [];
  if (container && roles.length > 1) {
    const INTERVAL = 2600;
    const MAX_STEPS = roles.length * 3;
    let index = 0;
    let steps = 0;
    let paused = false;
    let visible = true;

    const show = (next: number) => {
      const current = roles[index]!;
      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      window.setTimeout(() => current.classList.remove('is-leaving'), 600);
      index = next;
      roles[index]!.classList.add('is-active');
    };

    const timer = window.setInterval(() => {
      if (paused || !visible) return;
      steps += 1;
      show((index + 1) % roles.length);
      if (steps >= MAX_STEPS && index === 0) window.clearInterval(timer);
    }, INTERVAL);

    const badge = container.closest('.badge');
    badge?.addEventListener('mouseenter', () => (paused = true));
    badge?.addEventListener('mouseleave', () => (paused = false));
    new IntersectionObserver(([entry]) => (visible = entry?.isIntersecting ?? true)).observe(container);
  }

  /**
   * Refreshes the npm downloads stat with today's real count once the page is idle,
   * so it never competes with the first paint. On failure the build-time number stays.
   */
  const npmTotal = document.querySelector<HTMLElement>('[data-npm-total]');
  if (npmTotal) {
    const refresh = () =>
      totalDownloads()
        .then((total) => {
          npmTotal.dataset.countValue = String(total);
          // A running count-up (src/scripts/motion.ts) picks the new value up on its next frame.
          if (!('counting' in npmTotal.dataset)) {
            npmTotal.textContent = new Intl.NumberFormat(document.documentElement.lang).format(total);
          }
        })
        .catch(() => undefined);
    // Safari has no requestIdleCallback.
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(refresh, { timeout: 4000 });
    else setTimeout(refresh, 2000);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 72px) 0;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgb(17 17 17 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 17 17 / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    overflow: hidden;
  }

  /* The grid fades out towards the bottom, as in the design */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 460px);
    align-items: end;
    gap: clamp(32px, 4.5vw, 56px);
  }

  .hero-copy {
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  /* Entrance on load, staggered. Starts at a tiny non-zero opacity so the text
     still counts as painted for Largest Contentful Paint. Reduced motion: fade only. */
  .enter {
    animation: enter-fade 0.7s var(--ease) both;
    animation-delay: calc(var(--enter-index, 0) * 90ms + 60ms);
  }

  @keyframes enter-fade {
    from {
      opacity: 0.01;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation-name: enter;
      animation-duration: 0.9s;
      animation-delay: calc(var(--enter-index, 0) * 110ms + 60ms);
    }

    .enter--photo {
      animation-name: enter-photo;
      animation-duration: 1.1s;
    }
  }

  @keyframes enter {
    from {
      opacity: 0.01;
      transform: translate3d(0, 24px, 0);
    }
  }

  @keyframes enter-photo {
    from {
      transform: translate3d(0, 48px, 0) scale(0.98);
    }
  }

  /* Badge, like the Figma label in the design */
  .badge {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    margin-bottom: 18px;
    padding: 10px 0 0 6px;
  }

  .badge-mark {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--ink);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    transform: rotate(-8deg);
  }

  .badge-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px 7px 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .badge-pill strong {
    font-weight: 600;
  }

  .badge-sep,
  .roles {
    color: var(--ink-soft);
  }

  .roles {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .roles {
    display: grid;
    overflow: hidden;
  }

  .role {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  /* Without JS only the first role shows. */
  .roles .role:not(.is-active) {
    visibility: hidden;
  }

  :global(.js) .roles .role {
    visibility: visible;
    opacity: 0;
    transform: translateY(110%);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
  }

  :global(.js) .roles .role.is-active {
    opacity: 1;
    transform: none;
  }

  :global(.js) .roles .role.is-leaving {
    opacity: 0;
    transform: translateY(-110%);
  }

  /* Reduced motion: the roles cross-fade in place instead of sliding. */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .roles .role,
    :global(.js) .roles .role.is-leaving {
      transform: none;
    }
  }

  .hero :global(.hero-title) {
    font-size: clamp(2.3rem, 4.4vw, 3.75rem);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    max-width: 34rem;
    margin-top: 22px;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 32px);
    max-width: 38rem;
    margin-top: clamp(40px, 5vw, 56px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 12px;
    border-left: 1.5px solid var(--ink);
  }

  .stat dt {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .stat dd {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* Black & white cut-out portrait that "stands" on the dark section, as in the design.
     A square block behind it and a short shadow separate it from the light grid;
     the head rises above the block. */
  .hero-photo {
    position: relative;
    justify-self: end;
    width: 100%;
    isolation: isolate;
  }

  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 20% 2% 0 8%;
    z-index: -1;
    background: var(--backdrop);
  }

  .hero-photo :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.22));
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-photo {
      justify-self: center;
      width: min(80%, 380px);
      margin-top: 8px;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stat {
      display: grid;
      grid-template-columns: 4.75rem 1fr;
      grid-template-areas:
        'value label'
        'value detail';
      column-gap: 14px;
      row-gap: 2px;
      align-items: center;
    }

    .stat dt {
      display: contents;
    }

    .stat-value {
      grid-area: value;
    }

    .stat-label {
      grid-area: label;
    }

    .stat dd {
      grid-area: detail;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
