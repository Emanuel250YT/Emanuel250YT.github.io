---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import RichHeading from '@/components/ui/RichHeading.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge">
        <span class="badge-mark" aria-hidden="true">e.</span>
        <span class="badge-pill">
          <strong>{site.name}</strong>
          <span class="badge-sep" aria-hidden="true">/</span>
          <span class="badge-role">{t.hero.badgeRole}</span>
          <Icon name="cursor" size={18} class="badge-cursor" />
        </span>
      </p>

      <RichHeading as="h1" id="hero-title" class="hero-title" parts={t.hero.title} />

      <p class="lead">{t.hero.lead}</p>

      <div class="actions">
        <a class="btn btn--frame" href="#contact">
          <Icon name="chat" />
          {t.hero.ctaTalk}
        </a>
        <a class="btn btn--solid" href="#projects">{t.hero.ctaWork}</a>
      </div>

      <dl class="stats">
        {
          t.hero.stats.map((stat) => (
            <div class="stat">
              <dt>
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </dt>
              <dd>{stat.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="hero-photo">
      <Image
        src={portrait}
        alt={t.hero.photoAlt}
        widths={[340, 460, 600, 744]}
        sizes="(max-width: 860px) min(80vw, 380px), 460px"
        loading="eager"
        fetchpriority="high"
        class="photo"
      />
      <span class="chip chip--place">
        <Icon name="pin" size={14} />
        {t.hero.basedIn}
      </span>
      <span class="chip chip--status"><span class="dot" aria-hidden="true"></span>{t.hero.available}</span>
      <span class="peer-cursor" aria-hidden="true">
        <Icon name="cursor" size={20} />
        <span>{site.givenName}</span>
      </span>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 72px) 0;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgb(17 17 17 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 17 17 / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    overflow: hidden;
  }

  /* The grid fades out towards the bottom, as in the design */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 460px);
    align-items: end;
    gap: clamp(32px, 4.5vw, 56px);
  }

  .hero-copy {
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  /* Badge with cursor, like the Figma label in the design */
  .badge {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    margin-bottom: 18px;
    padding: 10px 0 0 6px;
  }

  .badge-mark {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    transform: rotate(-8deg);
  }

  .badge-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px 7px 14px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .badge-pill strong {
    font-weight: 600;
  }

  .badge-sep,
  .badge-role {
    color: var(--ink-soft);
  }

  .badge-role {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .badge-pill :global(.badge-cursor) {
    position: absolute;
    right: -14px;
    bottom: -14px;
    color: var(--ink);
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff);
  }

  .hero :global(.hero-title) {
    font-size: clamp(2.3rem, 4.4vw, 3.75rem);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    max-width: 34rem;
    margin-top: 22px;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 32px);
    max-width: 38rem;
    margin-top: clamp(40px, 5vw, 56px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 12px;
    border-left: 1.5px solid var(--ink);
  }

  .stat dt {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .stat dd {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* Black & white cut-out portrait that "stands" on the dark section, as in the design */
  .hero-photo {
    position: relative;
    justify-self: end;
    width: 100%;
  }

  .hero-photo :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .chip--place {
    top: 16%;
    right: 0;
  }

  .chip--status {
    bottom: 14%;
    left: -4%;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 4px rgb(22 163 74 / 0.18);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s ease-in-out infinite;
    }

    .peer-cursor {
      animation: drift 7s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 7px rgb(22 163 74 / 0.06);
    }
  }

  @keyframes drift {
    50% {
      transform: translate(-10px, 8px);
    }
  }

  /* Figma-style "collaborator" cursor */
  .peer-cursor {
    position: absolute;
    top: 44%;
    left: -6%;
    display: flex;
    align-items: flex-start;
    color: var(--ink);
    pointer-events: none;
  }

  .peer-cursor span {
    margin: 16px 0 0 -2px;
    padding: 3px 9px;
    border-radius: 4px 999px 999px 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-photo {
      justify-self: center;
      width: min(80%, 380px);
      margin-top: 8px;
    }

    .peer-cursor {
      left: -8%;
    }

    .chip--status {
      left: -10%;
    }

    .chip--place {
      right: -8%;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stat {
      display: grid;
      grid-template-columns: 4.75rem 1fr;
      grid-template-areas:
        'value label'
        'value detail';
      column-gap: 14px;
      row-gap: 2px;
      align-items: center;
    }

    .stat dt {
      display: contents;
    }

    .stat-value {
      grid-area: value;
    }

    .stat-label {
      grid-area: label;
    }

    .stat dd {
      grid-area: detail;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
