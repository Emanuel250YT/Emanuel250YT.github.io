---
import type { GetStaticPaths } from 'astro';
import PrivacyPage from '@/components/pages/PrivacyPage.astro';
import { prefixedLocales, type Locale } from '@/i18n/locales';

// The default locale (es) is served from src/pages/privacy.astro at /privacy/.
export const getStaticPaths = (() => prefixedLocales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<PrivacyPage locale={lang} />
