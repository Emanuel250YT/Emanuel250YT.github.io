---
import type { GetStaticPaths } from 'astro';
import CvPage from '@/components/pages/CvPage.astro';
import { prefixedLocales, type Locale } from '@/i18n/locales';

// The default locale (es) is served from src/pages/cv.astro at /cv/.
export const getStaticPaths = (() => prefixedLocales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<CvPage locale={lang} />
