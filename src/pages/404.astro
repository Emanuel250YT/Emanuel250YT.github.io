---
import Flag from '@/components/ui/Flag.astro';
import Icon from '@/components/ui/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';
import { defaultLocale, localeMeta, localePath, locales } from '@/i18n/locales';

// GitHub Pages serves this file for every missing path, whatever the language,
// so it is written in the default locale and links to every home page.
const t = useTranslations(defaultLocale);
---

<BaseLayout
  locale={defaultLocale}
  path="404"
  title={t.notFound.title}
  description={t.notFound.description}
  noindex
  alternates={false}
>
  <section class="container not-found" aria-labelledby="nf-title">
    <p class="code" aria-hidden="true">404</p>
    <h1 id="nf-title" class="display" data-type>{t.notFound.heading}</h1>
    <p class="text">{t.notFound.body}</p>
    <div class="actions">
      <a class="btn btn--solid" href={localePath(defaultLocale)}>
        <Icon name="arrow-left" />
        {t.notFound.back}
      </a>
    </div>

    <nav class="languages" aria-label={t.a11y.language}>
      <ul role="list">
        {
          locales.map((code) => (
            <li>
              <a href={localePath(code)} hreflang={localeMeta[code].hreflang} lang={localeMeta[code].htmlLang}>
                <Flag code={localeMeta[code].flag} />
                {useTranslations(code).notFound.back}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 96px;
    background-image:
      linear-gradient(color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .code {
    font-size: clamp(4rem, 14vw, 9rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--muted);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .text {
    max-width: 32rem;
    margin-top: 16px;
    color: var(--ink-soft);
  }

  .actions {
    margin-top: 32px;
  }

  .languages ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 40px 0 0;
  }

  .languages a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .languages a:hover {
    color: var(--ink);
  }
</style>
